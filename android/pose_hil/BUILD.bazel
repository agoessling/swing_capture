    name = "android_pose_replay_hil_test",
    size = "medium",
    srcs = ["pose_replay_hil_test.cc"],
    args = [
        "$(rootpath //tools/android:adb)",
        "$(rootpath //android/app:swing_capture.apk)",
    ],
    data = [
        "//android/app:swing_capture.apk",
        "//tools/android:adb",
    ],
    tags = [
        "exclusive",
        "hil",
        "local",
        "manual",
        "no-sandbox",
        "requires-android-phone",
    ],
    timeout = "short",
    deps = [
        ":pose_replay_hil_support",
        "//android/hil:pose_replay_report_validation",
        "@nlohmann_json//:json",
    ],
)

