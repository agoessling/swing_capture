# Destructive only in the narrow sense that it intentionally reboots two explicitly selected
# phones. It never installs an APK or mutates configuration, and requires a literal acknowledgement
# plus a local operator for first unlock and foreground launch. See docs/android.md.
cc_test(
    name = "dual_phone_os_reboot_ceremony_hil_test",
    size = "large",
    srcs = ["os_reboot_ceremony_hil_test.cc"],
    args = [
        "$(rootpath //tools/android:adb)",
        "$(rootpath //android/app:swing_capture.apk)",
        "$(rootpath //tools:android_apk_installer)",
    ],
    data = [
