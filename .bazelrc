common --enable_bzlmod
common --announce_rc
try-import %workspace%/.bazelrc.local

build --incompatible_strict_action_env
build --show_timestamps
build --compilation_mode=opt
build --copt=-g
build --cxxopt=-std=c++23
build --strip=never

test --test_output=errors

build:asan --strip=never
build:asan --build_tag_filters=-no-host-sanitizer
build:asan --copt=-O1
# GCC 15 reports a false positive from libstdc++ std::regex when ASan and
# optimization are combined. Keep the warning visible without failing the
# sanitizer build; all other warnings remain errors.
build:asan --copt=-Wno-error=maybe-uninitialized
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address

build:ubsan --strip=never
build:ubsan --build_tag_filters=-no-host-sanitizer
build:ubsan --copt=-O1
# Match the narrowly scoped GCC/libstdc++ exception used by ASan.
build:ubsan --copt=-Wno-error=maybe-uninitialized
# AprilTag enables its own -Werror and GCC 15 emits this warning from glibc's
# fortified vsnprintf wrapper only in the UBSan configuration. Limit the
# exception to that external repository.
build:ubsan --per_file_copt=external/apriltag[+]/.*@-Wno-error=format-truncation
build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --linkopt=-fsanitize=undefined

# ##BAZEL_DEVTOOLS_MANAGED_BEGIN:bazelrc-import##
try-import %workspace%/.bazelrc.bazel_devtools
# ##BAZEL_DEVTOOLS_MANAGED_END:bazelrc-import##
