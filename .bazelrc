common --enable_bzlmod
common --announce_rc
common --enable_platform_specific_config
common --repo_env=ACCEPTED_ANDROID_SDK_LICENSE_VERSION=36
common --repo_env=ACCEPTED_ANDROID_NDK_LICENSE_VERSION=r25c
common --java_language_version=17
common --java_runtime_version=remotejdk_21
common --tool_java_language_version=17
common --tool_java_runtime_version=remotejdk_21
try-import %workspace%/.bazelrc.local

# Keep the one shared development server and its persistent workers bounded. A
# prior profiling failure left eleven servers alive; the ordinary server also
# retained four desugar and two javac workers plus an 8 GiB server heap. These
# limits preserve warm workers while preventing one checkout from claiming the
# whole 32 GiB host. Thirty idle minutes releases the pool after a work session.
startup --host_jvm_args=-Xmx3072m
startup --max_idle_secs=1800
build --jobs=8
build --local_resources=memory=12288
build --worker_max_instances=4
# rules_android launches each persistent Desugar worker with an 8 GiB JVM
# ceiling. Two workers retain useful parallelism while preventing four such
# JVMs from expanding together during an APK rebuild.
build --worker_max_instances=Desugar=2
build --experimental_worker_memory_limit_mb=1536
# Worker instance limits apply independently to each worker key. Bound the
# aggregate retained worker pool as well, evicting idle workers only after all
# worker kinds together exceed 6 GiB.
build --experimental_total_worker_memory_limit_mb=6144

mobile-install:linux --adb=external/+android+androidsdk_linux/platform-tools/linux/adb
mobile-install:macos --adb=external/+android+androidsdk_darwin/platform-tools/darwin/adb
mobile-install:windows --adb=external/+android+androidsdk_windows/platform-tools/windows/adb.exe

build --incompatible_strict_action_env
build --show_timestamps
build --compilation_mode=opt
build --copt=-g
build --cxxopt=-std=c++23
build --strip=never
# Android core libraries use Java 17 records. Package the D8 global synthetics
# and desugared JDK runtime required on-device, rather than only desugaring each
# dependency jar in isolation.
build --desugar_java8_libs
# The supported capture phones are arm64. This also selects the matching
# MediaPipe Tasks JNI from its pinned Android AAR for every install/HIL APK.
build --android_platforms=//android/pose_inference:android_arm64

test --test_output=errors

build:asan --strip=never
build:asan --build_tag_filters=-no-host-sanitizer
build:asan --copt=-O1
# GCC 15 reports a false positive from libstdc++ std::regex when ASan and
# optimization are combined. Keep the warning visible without failing the
# sanitizer build; all other warnings remain errors.
build:asan --copt=-Wno-error=maybe-uninitialized
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address

build:ubsan --strip=never
build:ubsan --build_tag_filters=-no-host-sanitizer
build:ubsan --copt=-O1
# Match the narrowly scoped GCC/libstdc++ exception used by ASan.
build:ubsan --copt=-Wno-error=maybe-uninitialized
# AprilTag enables its own -Werror and GCC 15 emits this warning from glibc's
# fortified vsnprintf wrapper only in the UBSan configuration. Limit the
# exception to that external repository.
build:ubsan --per_file_copt=external/apriltag[+]/.*@-Wno-error=format-truncation
build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --linkopt=-fsanitize=undefined

# ##BAZEL_DEVTOOLS_MANAGED_BEGIN:bazelrc-import##
try-import %workspace%/.bazelrc.bazel_devtools
# ##BAZEL_DEVTOOLS_MANAGED_END:bazelrc-import##

# Wildcard software validation excludes `manual` tests from analysis and
# compilation. Physical tests remain explicit, while the named static-check
# configuration below keeps manual-only sources and dependencies from rotting.
build --nobuild_manual_tests

# Keep the transition-sensitive lint failure build setting aligned across
# build/run/test without running lint aspects during ordinary tests or APK
# packaging. The aspects run only under the explicit precommit configuration.
build --@@aspect_rules_lint+//lint:fail_on_violation

# Fast Android Java inner loop. This deliberately skips non-test siblings such
# as the APK; build //android/app:swing_capture separately when packaging code
# changes, and retain `bazel test //...` as the repository-wide checkpoint.
test:android_inner --build_tests_only
test:android_inner --nobuild_manual_tests

# Opt-in physical Android development lane. The runner skips APK installation
# only after the installed monolithic base APK exactly matches the Bazel APK.
# The ordinary HIL target remains a forced verified reinstall.
test:android_hil_inner --test_env=SWING_CAPTURE_ANDROID_SKIP_EXACT_APK_INSTALL=true

# Compile (but never execute) every manual test selected by a wildcard. Use
# this explicit check after editing HIL-only code.
build:manual_test_static_check --build_manual_tests
