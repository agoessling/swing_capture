diff --git a/va/va_version.h b/va/va_version.h
new file mode 100644
index 0000000..c671cde
--- /dev/null
+++ b/va/va_version.h
@@ -0,0 +1,18 @@
+#ifndef VA_VERSION_H
+#define VA_VERSION_H
+
+#define VA_MAJOR_VERSION 1
+#define VA_MINOR_VERSION 23
+#define VA_MICRO_VERSION 0
+#define VA_VERSION 1.23.0
+#define VA_VERSION_S "1.23.0"
+#define VA_VERSION_HEX \
+  ((VA_MAJOR_VERSION << 24) | (VA_MINOR_VERSION << 16) | (VA_MICRO_VERSION << 8))
+
+#define VA_CHECK_VERSION(major, minor, micro)                                      \
+  (VA_MAJOR_VERSION > (major) ||                                                  \
+   (VA_MAJOR_VERSION == (major) && VA_MINOR_VERSION > (minor)) ||                 \
+   (VA_MAJOR_VERSION == (major) && VA_MINOR_VERSION == (minor) &&                 \
+    VA_MICRO_VERSION >= (micro)))
+
+#endif
