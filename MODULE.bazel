http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libva_headers",
    build_file = "//third_party/libva:libva_headers.BUILD.bazel",
    integrity = "sha256-sQrOsw6T3fE7IDDrcAeVdLpDe+mzt2BlyvKKcsB+I+c=",
    patch_strip = 1,
    patches = ["//third_party/libva:libva_version.patch"],
    strip_prefix = "libva-2.23.0",
    urls = ["https://github.com/intel/libva/archive/refs/tags/2.23.0.tar.gz"],
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.22.0")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.22.0",
    pnpm_version_integrity = "sha512-vwSe/plbKPUn/StBrgR0zikYb37cs79UUIe9Yfu+uyv3U2LRMH/aCcLSiOHkmXh6wS1Py2F6l0cYpgUfLu50HA==",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//web:pnpm-lock.yaml",
)
use_repo(npm, "npm")

playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    browsers_json = "//web:playwright-browsers.json",
    integrity_path_map = {
        "builds/chromium/1169/chromium-headless-shell-linux.zip": "sha256-kuxxKkmkUet0toKa5Lx+4vNkINKEnCRdu7NxCLQd6SA=",
    },
)
use_repo(playwright, "playwright")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11.14")
python.toolchain(python_version = "3.11.14")

register_toolchains(
    "@pico-sdk//bazel/toolchain:linux-x86_64-rp2040",
)

single_version_override(
    module_name = "pico-sdk",
    patch_strip = 1,
    patches = ["//third_party/pico_sdk:pico_usb_reset_dependency.patch"],
    version = "2.3.0",
)

daheng_galaxy_sdk_repository = use_repo_rule(
    "//third_party/daheng:repository.bzl",
    "daheng_galaxy_sdk_repository",
)

daheng_galaxy_sdk_repository(
    name = "daheng_galaxy_sdk",
)

