python.defaults(python_version = "3.11.14")
python.toolchain(python_version = "3.11.14")

pose_inference_pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pose_inference_pip.parse(
    hub_name = "pose_inference_pip",
    python_version = "3.11",
    requirements_lock = "//tools/pose_inference:requirements_lock.txt",
)
use_repo(pose_inference_pip, "pose_inference_pip")

# MediaPipe Tasks Vision is kept in a separate, pinned Maven graph so its
# Android transitive dependencies do not leak into unrelated host targets.
mediapipe_android_maven = use_extension(
    "@rules_jvm_external//:extensions.bzl",
    "maven",
)
mediapipe_android_maven.install(
    name = "mediapipe_android",
    artifacts = ["com.google.mediapipe:tasks-vision:0.10.35"],
    fail_if_repin_required = True,
    lock_file = "//third_party/mediapipe:artifacts.lock.json",
    repositories = [
        "https://dl.google.com/dl/android/maven2",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(mediapipe_android_maven, "mediapipe_android")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "pose_landmarker_lite_task",
    downloaded_file_path = "pose_landmarker_lite.task",
    integrity = "sha256-WZKeHR7pUodzXd2DOxnPSsRtKbx6/du/Z1PEWWkNV0o=",
    urls = [
        "https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task",
    ],
)

