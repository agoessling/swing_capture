        "fixtures/production_h264/face-on.mp4",
        "fixtures/production_h264/face-on-gop30.mp4",
        "fixtures/production_h264/scenario.json",
    ] + glob(["src/review.e2e.spec.ts-snapshots/*.png"], allow_empty = True),
    env = {
        "PLAYWRIGHT_BROWSERS_PATH": "$(rootpath @playwright//:chromium-headless-shell)/../",
        "SWING_CAPTURE_FIXTURE_APP": "$(rootpath :fixture_demo)",
        "SWING_CAPTURE_PRODUCTION_H264_FIXTURE": "$(rootpath fixtures/production_h264/scenario.json)/..",
        "SWING_CAPTURE_STATIC_APP": "$(rootpath :static_app)",
    },
    # Four isolated Playwright workers keep the wall time below 20 seconds but
    # together use about a GiB, materially more memory than a Bazel small test. Reserve a
    # realistic scheduler class while keeping the short timeout fail-closed.
    size = "enormous",
    timeout = "short",
)

# The checksum-pinned Chromium headless shell intentionally lacks proprietary AVC decoding. This
# local, opt-in companion runs the same checked-in two-origin fixture through an installed Chrome
# so the H.264 decode, nonblack-pixel, seek, and exact-frame assertions are still executable via a
# Bazel target without weakening the hermetic default browser suite.
strict_cc_test(
    name = "system_h264_browser_test",
    size = "small",
    srcs = ["run_test_executable.cc"],
    args = [
        "$(rootpath :browser_test)",
        "test",
        "--config",
        "web/playwright.config.ts",
        "--grep",
        "two.*origins",
    ],
    data = [
        ":browser_test",
    ],
    env = {
        "SWING_CAPTURE_CHROME_EXECUTABLE": "/usr/bin/google-chrome",
        "SWING_CAPTURE_REQUIRE_H264_DECODE": "1",
    },
    tags = [
        "exclusive",
        "local",
        "manual",
    ],
)

# Playwright's Firefox protocol requires its patched browser, so the installed stock Firefox cannot
# be driven by //web:browser_test. This local companion uses the matching installed geckodriver and
# the same checked-in one-second-GOP fixtures to make codec, HTTP Range, RVFC media-time, decoded
# pixels, bidirectional GOP seeks, IDR-boundary stepping, repeatability, and playback mandatory.
py_test(
    name = "system_firefox_h264_browser_test",
    size = "small",
    srcs = ["system_firefox_h264_test.py"],
    data = [
        "fixtures/production_h264/down-the-line-gop30.mp4",
        "fixtures/production_h264/face-on-gop30.mp4",
    ],
    main = "system_firefox_h264_test.py",
    tags = [
        "exclusive",
        "local",
        "manual",
    ],
)

